{
  "name": "genkaku",
  "private": true,
  "version": "0.6.0-rc.1",
  "description": "GenKaKu \u2014 DSH (DeepSeek Harness) worker and user plugins, libp2p inference and Solana USDC campaigns",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "packageManager": "pnpm@10.8.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/**' run build",
    "typecheck": "pnpm -r --filter './packages/**' run typecheck",
    "test": "pnpm -r --filter './packages/**' run test",
    "sync": "bash scripts/sync-release.sh"
  },
  "devDependencies": {
    "@solana/spl-token": "^0.4.9",
    "@types/node": "^22",
    "esbuild": "^0.25.0",
    "tsx": "^4",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "overrides": {
      "@libp2p/crypto": "5.1.8",
      "@multiformats/dns": "1.0.12"
    }
  }
}
