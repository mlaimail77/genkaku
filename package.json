{
  "name": "genkaku",
  "version": "0.1.0",
  "private": true,
  "description": "GenKaKu — peer-to-peer AI compute for DeepSeek Harness, settled in USDC on Base",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "packageManager": "pnpm@10.8.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "contracts:build": "cd web3 && forge build",
    "contracts:test": "cd web3 && forge test"
  },
  "devDependencies": {
    "@types/node": "^22",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "overrides": {
      "@libp2p/crypto": "5.1.8",
      "@multiformats/dns": "1.0.12"
    }
  }
}
